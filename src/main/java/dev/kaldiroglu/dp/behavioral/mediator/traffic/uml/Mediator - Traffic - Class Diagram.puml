@startuml "Mediator - Traffic - Class Diagram"
skinparam classAttributeIconSize 0
skinparam linetype polyline
hide empty members
title A traffic police officer at a junction
interface TrafficMediator <<Mediator>> {
  + askPermitToPass(Vehicle)
  + done(Vehicle)
}
class TrafficPolice <<ConcreteMediator>>
interface Vehicle <<Colleague>> {
  + approach()
  + proceed()
  + stop()
}
class Car
class Junction {
  - busy : boolean
}
TrafficMediator -[hidden]right- Vehicle
TrafficMediator <|.. TrafficPolice
Vehicle <|.. Car
TrafficPolice --> Junction
TrafficPolice -[norank]-> "*" Vehicle : waiting
Car -[norank]-> TrafficMediator
@enduml
