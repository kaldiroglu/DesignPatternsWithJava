@startuml "Observer - Publisher - Class Diagram"
skinparam linetype polyline
skinparam nodesep 140
skinparam classAttributeIconSize 0
hide empty members
title Magazines and their subscribers
interface Publication <<Subject>> {
  + addSubscriber(Subscriber)
  + removeSubscriber(Subscriber)
  + publish(date)
}
abstract class AbstractPublication {
  # subscribers : List<Subscriber>
}
class Newsweek
class FourFourTwo
interface Subscriber <<Observer>> {
  + receive(Publication)
}
abstract class AbstractSubscriber
class IndividualSubscriber {
  + read(Publication)
}
class InstitutionalSubscriber {
  + putOnShelf(Publication)
}
class Publisher
Publication <|.. AbstractPublication
AbstractPublication <|-- Newsweek
AbstractPublication <|-- FourFourTwo
Subscriber <|.. AbstractSubscriber
AbstractSubscriber <|-- IndividualSubscriber
AbstractSubscriber <|-- InstitutionalSubscriber
note bottom of Subscriber
  Each kind of subscriber reacts
  in its own way: one reads,
  one puts it on the shelf.
end note
AbstractPublication o-[norank]-> "*" Subscriber
Publisher -[norank]-> Newsweek
Publisher -[norank]-> FourFourTwo
@enduml
