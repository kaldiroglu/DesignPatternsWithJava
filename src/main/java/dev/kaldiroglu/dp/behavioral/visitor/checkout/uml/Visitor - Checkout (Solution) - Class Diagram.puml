@startuml "Visitor - Checkout (Solution) - Class Diagram"
skinparam linetype polyline
skinparam class {
  BackgroundColor<<spacer>> transparent
  BorderColor<<spacer>> transparent
  FontColor<<spacer>> transparent
}
hide <<spacer>> stereotype
hide <<spacer>> circle
skinparam classAttributeIconSize 0
hide empty members
title Items accept visitors; each operation is one visitor
interface Item <<Element>> {
  + accept(ItemVisitor<R>) : R
}
class Book <<record>>
class Food <<record>>
class Electronics <<record>>
class GiftCard <<record>>
interface "ItemVisitor<R>" as V <<Visitor>> {
  + visit(Book) : R
  + visit(Food) : R
  + visit(Electronics) : R
  + visit(GiftCard) : R
}
class TaxVisitor
class ShippingVisitor
class ReceiptLineVisitor
class Checkout <<ObjectStructure>> {
  + total(ItemVisitor<Integer>) : int
}
Item <|.. Book
Item <|.. Food
Item <|.. Electronics
Item <|.. GiftCard
V <|.. TaxVisitor
V <|.. ShippingVisitor
V <|.. ReceiptLineVisitor
note bottom of V
  <b>A new item kind is a new method here.</b>
  Every visitor that misses it stops compiling.
end note
class " " as Spacer1 <<spacer>>
Item -[hidden]- Spacer1
Item -[hidden]- Spacer1
Book -[hidden]right- Food
Food -[hidden]right- Spacer1
Spacer1 -[hidden]right- Electronics
Electronics -[hidden]right- GiftCard
V -[hidden]- ShippingVisitor
V -[hidden]- ShippingVisitor
TaxVisitor -[hidden]right- ShippingVisitor
ShippingVisitor -[hidden]right- ReceiptLineVisitor
Checkout o-[norank]-> "*" Item
Item .[norank].> V : accept calls visit(this)
@enduml
