@startuml "Visitor - File - Class Diagram"
skinparam classAttributeIconSize 0
hide empty members
title Files: checks in an operator, then in a visitor
package problem2 {
  class FileOperator {
    + operate(List<File>)
  }
  note bottom of FileOperator
    instanceof and casts
    for each kind of file.
  end note
}
package pattern1 {
  abstract class File {
    + accept(Visitor) : boolean
  }
  interface Visitor {
    + visit(TextFile) : boolean
    + visit(XMLFile) : boolean
  }
  class FileVisitor
  Visitor <|.. FileVisitor
  File ..> Visitor
}
FileOperator -[hidden]right- File
@enduml
