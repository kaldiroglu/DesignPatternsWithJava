@startuml "State - Door - Class Diagram"
skinparam linetype polyline
skinparam classAttributeIconSize 0
hide empty members
title A door: who changes its state?

package "problem" {
  class "Door" as D0 {
    - open : boolean
    + open()
    + close()
  }
}
package "pattern1 · the states decide" {
  class "Door" as D1 {
    - state : DoorState
    ~ changeState(DoorState)
  }
  interface "DoorState" as S1
  class "OpenDoor" as O1
  class "ClosedDoor" as C1
  S1 <|.. O1
  S1 <|.. C1
}
package "pattern2 · a manager decides" {
  class "Door" as D2 {
    - state : DoorState
  }
  class DoorStateManager {
    + next(DoorState)
  }
  interface "DoorState" as S2
  class "OpenDoor" as O2
  class "ClosedDoor" as C2
  S2 <|.. O2
  S2 <|.. C2
}
  D1 o--> S1
  O1 .[norank].> C1 : knows
  C1 .[norank].> O1 : knows
  D2 o-[norank]-> S2
  D2 --> DoorStateManager
  O2 -[norank]-> DoorStateManager
  C2 --> DoorStateManager
D0 -[hidden]right- D1
D1 -[hidden]right- D2
@enduml
