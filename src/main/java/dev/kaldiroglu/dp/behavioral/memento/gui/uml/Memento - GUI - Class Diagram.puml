@startuml "Memento - GUI - Class Diagram"
skinparam classAttributeIconSize 0
hide empty members
title A GUI component that saves its state in a memento
class GuiComponent <<Originator>> {
  - x, y, length, width
  + createMemento() : GuiComponentMemento
  + restore(GuiComponentMemento)
}
class GuiComponentMemento <<Memento>> {
  + getState() : GuiComponentState
}
class GuiComponentState <<record>> {
  x, y, length, width
}
class Main <<Caretaker>>
Main --> GuiComponentMemento : keeps
Main --> GuiComponent
GuiComponent ..> GuiComponentMemento : creates
GuiComponentMemento --> GuiComponentState
@enduml
