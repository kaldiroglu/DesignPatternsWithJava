@startuml
' begin shared style: tools/creational-uml-style.iuml
skinparam backgroundColor transparent
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Helvetica
skinparam defaultFontSize 18
skinparam dpi 200
skinparam roundCorner 6
skinparam ArrowColor #334155
skinparam ArrowFontColor #475569
skinparam ArrowFontSize 16
skinparam rectangle {
  BackgroundColor #F8FAFC
  BorderColor #6366F1
  FontColor #0F172A
}
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #6366F1
  BorderThickness 1.6
  FontColor #0F172A
  FontStyle plain
  AttributeFontColor #475569
  AttributeFontSize 16
  AttributeFontStyle plain
  StereotypeFontColor #6366F1
  StereotypeFontSize 14
}
skinparam object {
  BackgroundColor #EEF2FF
  BorderColor #6366F1
  BorderThickness 1.6
  FontColor #0F172A
}
skinparam note {
  BackgroundColor #FEF9C3
  BorderColor #F59E0B
  FontColor #0F172A
  FontSize 16
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #94A3B8
  FontColor #475569
  FontSize 16
}
skinparam sequence {
  ArrowColor #334155
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #E2E8F0
  ParticipantBackgroundColor #F8FAFC
  ParticipantBorderColor #6366F1
  ParticipantFontColor #0F172A
  ParticipantFontSize 17
  ActorBackgroundColor #F8FAFC
  ActorBorderColor #6366F1
  DividerBackgroundColor #EEF2FF
  DividerBorderColor #6366F1
  DividerFontColor #0F172A
  GroupBackgroundColor #EEF2FF
}
hide empty members
hide circle
' end shared style
  class Employee {
    - firstName : String
    - lastName : String
    - email : String
    - phoneNumber : String
    - department : String
    - position : String
    - employeeId : String
    - hireDate : java.time.LocalDate
    - birthDate : java.time.LocalDate
    - salary : java.math.BigDecimal
    - manager : String
    - workLocation : String
    - employmentType : String
    - securityClearance : String
    - emergencyContact : String
    - emergencyPhone : String
    - isRemoteWorker : boolean
    - timeZone : String
    - skills : String
    - education : String
    - previousCompany : String

    + Employee()

    + Employee(firstName : String, lastName : String, email : String, department : String)

    + Employee(firstName : String, lastName : String, email : String, department : String,
               position : String, hireDate : java.time.LocalDate)

    + Employee(firstName : String, lastName : String,  email : String, phoneNumber : String, department : String, position : String, employeeId : String, hireDate : java.time.LocalDate,
               salary : java.math.BigDecimal, manager : String)

    + setFirstName(firstName : String) : void
    + setLastName(lastName : String) : void
    + setEmail(email : String) : void
    + setPhoneNumber(phoneNumber : String) : void
    + setDepartment(department : String) : void
    + setPosition(position : String) : void
    + setEmployeeId(employeeId : String) : void
    + setHireDate(hireDate : java.time.LocalDate) : void
    + setBirthDate(birthDate : java.time.LocalDate) : void
    + setSalary(salary : java.math.BigDecimal) : void
    + setManager(manager : String) : void
    + setWorkLocation(workLocation : String) : void
    + setEmploymentType(employmentType : String) : void
    + setSecurityClearance(securityClearance : String) : void
    + setEmergencyContact(emergencyContact : String) : void
    + setEmergencyPhone(emergencyPhone : String) : void
    + setRemoteWorker(remoteWorker : boolean) : void
    + setTimeZone(timeZone : String) : void
    + setSkills(skills : String) : void
    + setEducation(education : String) : void
    + setPreviousCompany(previousCompany : String) : void
  }
@enduml