@startuml
' begin shared style: tools/creational-uml-style.iuml
skinparam backgroundColor transparent
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Helvetica
skinparam defaultFontSize 18
skinparam dpi 200
skinparam roundCorner 6
skinparam ArrowColor #334155
skinparam ArrowFontColor #475569
skinparam ArrowFontSize 16
skinparam rectangle {
  BackgroundColor #F8FAFC
  BorderColor #6366F1
  FontColor #0F172A
}
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #6366F1
  BorderThickness 1.6
  FontColor #0F172A
  FontStyle plain
  AttributeFontColor #475569
  AttributeFontSize 16
  AttributeFontStyle plain
  StereotypeFontColor #6366F1
  StereotypeFontSize 14
}
skinparam object {
  BackgroundColor #EEF2FF
  BorderColor #6366F1
  BorderThickness 1.6
  FontColor #0F172A
}
skinparam note {
  BackgroundColor #FEF9C3
  BorderColor #F59E0B
  FontColor #0F172A
  FontSize 16
}
skinparam package {
  BackgroundColor #FFFFFF
  BorderColor #94A3B8
  FontColor #475569
  FontSize 16
}
skinparam sequence {
  ArrowColor #334155
  LifeLineBorderColor #94A3B8
  LifeLineBackgroundColor #E2E8F0
  ParticipantBackgroundColor #F8FAFC
  ParticipantBorderColor #6366F1
  ParticipantFontColor #0F172A
  ParticipantFontSize 17
  ActorBackgroundColor #F8FAFC
  ActorBorderColor #6366F1
  DividerBackgroundColor #EEF2FF
  DividerBorderColor #6366F1
  DividerFontColor #0F172A
  GroupBackgroundColor #EEF2FF
}
hide empty members
hide circle
' end shared style
title Refactored Employee - Class Diagram

class Employee {
  - personal : PersonalInfo
  - contact : ContactInfo
  - job : JobInfo
  - work : WorkInfo
  - compensation : Compensation
  + Employee(PersonalInfo, ContactInfo, JobInfo, WorkInfo, Compensation)
  + getPersonal() : PersonalInfo
  + getContact() : ContactInfo
  + getJob() : JobInfo
  + getWork() : WorkInfo
  + getCompensation() : Compensation
}

class PersonalInfo {
  - firstName : String
  - lastName : String
  - birthDate : LocalDate
  - education : String
  - skills : String
  - previousCompany : String
  + getters/setters()
}

class ContactInfo {
  - email : String
  - phoneNumber : String
  - emergencyContact : String
  - emergencyPhone : String
  + getters/setters()
}

class JobInfo {
  - employeeId : String
  - department : String
  - position : String
  - manager : String
  - hireDate : LocalDate
  - employmentType : String
  - securityClearance : String
  + getters/setters()
}

class WorkInfo {
  - workLocation : String
  - isRemoteWorker : boolean
  - timeZone : String
  + getters/setters()
}

class Compensation {
  - salary : BigDecimal
  + getters/setters()
}

Employee "1" *-- "1" PersonalInfo
Employee "1" *-- "1" ContactInfo
Employee "1" *-- "1" JobInfo
Employee "1" *-- "1" WorkInfo
Employee "1" *-- "1" Compensation

'note right of Employee
'  Defaults applied in Employee():
'  - job.hireDate = LocalDate.now()
'  - job.employmentType = "Full-time"
'  - work.isRemoteWorker = false
'  - work.timeZone = "EST"
'end note
@enduml