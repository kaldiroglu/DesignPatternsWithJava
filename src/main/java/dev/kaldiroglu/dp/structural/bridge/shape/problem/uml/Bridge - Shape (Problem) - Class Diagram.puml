@startuml "Bridge - Shape (Problem) - Class Diagram"
skinparam class {
  BackgroundColor<<spacer>> transparent
  BorderColor<<spacer>> transparent
  FontColor<<spacer>> transparent
}
hide <<spacer>> stereotype
hide <<spacer>> circle
skinparam linetype polyline
skinparam nodesep 30
skinparam classAttributeIconSize 0
hide empty members
title Bridge — the device as a superclass


interface Shape {
  + draw() : void
  + erase() : void
}

abstract class AbstractShape {
  - name : String
}

abstract class Circle
abstract class Rectangle
abstract class Triangle

class CircleMacOS
class CircleXWindows
class RectangleMacOS
class RectangleXWindows
class TriangleMacOS
class TriangleXWindows

Shape <|.. AbstractShape
AbstractShape <|-- Circle
AbstractShape <|-- Rectangle
AbstractShape <|-- Triangle
Circle <|-- CircleMacOS
Circle <|-- CircleXWindows
Rectangle <|-- RectangleMacOS
Rectangle <|-- RectangleXWindows
Triangle <|-- TriangleMacOS
Triangle <|-- TriangleXWindows

note as N1
  <b>The device is the class.</b>
  An object cannot change its class, so a
  CircleMacOS is a MacOS circle for life —
  there is no setDrawer to write.

  3 shapes x 2 devices = <b>6 leaf classes</b>,
  plus 4 abstract ones.
  A third device: <b>+3</b>. A fourth shape: <b>+2</b>.
end note

class " " as Spacer51 <<spacer>>
Circle -[hidden]- Spacer51
Circle -[hidden]- Spacer51
CircleMacOS -[hidden]right- Spacer51
Spacer51 -[hidden]right- CircleXWindows
class " " as Spacer52 <<spacer>>
Triangle -[hidden]- Spacer52
Triangle -[hidden]- Spacer52
TriangleMacOS -[hidden]right- Spacer52
Spacer52 -[hidden]right- TriangleXWindows
@enduml
