@startuml "Proxy - Prime Minister - Class Diagram"
skinparam linetype polyline
skinparam nodesep 70
skinparam class {
  BackgroundColor<<spacer>> transparent
  BorderColor<<spacer>> transparent
  FontColor<<spacer>> transparent
}
hide <<spacer>> stereotype
hide <<spacer>> circle
skinparam classAttributeIconSize 0
hide empty members
title Proxy — four stages: pm3 is the pattern, and pm4 makes the proxy lazy


package "pm1 — no proxy" {
  class PM1 as "PM" {
    + listen(problem)
    + findJob(name)
    - worthMyTime(problem) : boolean
  }
  class Citizen1 as "Citizen"
}

package "pm2 — a stand-in, but no shared type" {
  class PM2 as "PM"
  class Proxy2 as "Proxy" {
    + listen(problem)
    - worthHisTime(problem)
  }
  class Citizen2 as "Citizen"
}

package "pm3 — the pattern" {
  interface PM3 as "PM" <<Subject>> {
    + listen(problem)
    + findJob(name)
  }
  class RealPM <<RealSubject>>
  class ProxyPM <<Proxy>>
  class PMSecretary
  class Citizen3 as "Citizen"

  PM3 <|.. RealPM
  PM3 <|.. ProxyPM
}

note bottom of PM1
  The screening rule lives <b>inside</b>
  the class it exists to protect.
end note

note bottom of Citizen2
  The field had to change from PM
  to Proxy. <b>Every client was edited</b>
  to accept the stand-in — which is
  what a proxy should make unnecessary.
end note

note bottom of Citizen3
  The field is <b>PM</b>, an interface now.
  In stage 1 PM was a class. Screening
  happens and this class does not know it does.
end note

package "pm4 — protection and virtual proxy" {
  interface PM4 as "PM" <<Subject>> {
    + listen(problem)
    + findJob(name)
  }
  class RealPM4 as "RealPM" <<RealSubject>>
  class ProxyPM4 as "ProxyPM" <<Proxy>> {
    - realPM() : RealPM
  }
  class Citizen4 as "Citizen"

  PM4 <|.. RealPM4
  PM4 <|.. ProxyPM4
}

class " " as Spacer1 <<spacer>>
PM3 -[hidden]- Spacer1
PM3 -[hidden]- Spacer1
RealPM -[hidden]right- Spacer1
Spacer1 -[hidden]right- ProxyPM
class " " as Spacer2 <<spacer>>
PM4 -[hidden]- Spacer2
PM4 -[hidden]- Spacer2
RealPM4 -[hidden]right- Spacer2
Spacer2 -[hidden]right- ProxyPM4
  Citizen1 -[norank]-> PM1
  Citizen2 -[norank]-> Proxy2
  Proxy2 -[norank]-> PM2
  ProxyPM o-[norank]-> "1" PM3
  PMSecretary .[norank].> ProxyPM : creates
  Citizen3 -[norank]-> PM3
  ProxyPM4 .[norank].> RealPM4 : creates on the first forwarded call
  Citizen4 -[norank]-> PM4
@enduml
